# --- Chat agent: Google Gemini (free tier) -------------------------------------------------------
# Free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# MODEL=gemini-flash-latest   # default. Pin a model here if your key has no free quota on it (docs/setup.md)

# --- Calendar + contact sheet: Google service account --------------------------------------------
# Share the calendar and the sheet with the service account's email. Separate from the Gemini key.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# ...or paste the whole key JSON on one line instead (for hosts without files):
# GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
GOOGLE_SHEET_ID=

# --- Phone: Vapi (optional, docs/voice.md) -------------------------------------------------------
VAPI_API_KEY=
PUBLIC_URL=https://your-tunnel.ngrok.app
VAPI_WEBHOOK_SECRET=
# VAPI_ASSISTANT_ID=   (printed by `npm run vapi` the first time)

# --- Dev -----------------------------------------------------------------------------------------
# PORT=3000
# FAKE=1   # in-memory calendar + sheet with the demo week: try the agent without Google Calendar/Sheets
