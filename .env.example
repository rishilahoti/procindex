# Chat agent
ANTHROPIC_API_KEY=
# MODEL=claude-sonnet-5-5

# Google: service account key. Share the calendar and the sheet with the service account's email.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# ...or paste the whole key JSON on one line instead (for hosts without files):
# GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
GOOGLE_SHEET_ID=

# Phone (Vapi)
VAPI_API_KEY=
PUBLIC_URL=https://your-tunnel.ngrok.app
VAPI_WEBHOOK_SECRET=
# VAPI_ASSISTANT_ID=   (printed by `npm run vapi` the first time)

# PORT=3000
# FAKE=1   # in-memory calendar + sheet with the demo week: try the agent without Google
